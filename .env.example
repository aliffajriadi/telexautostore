NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
DATABASE_URL=mysql://root:password@localhost:3306/telexautostore
SESSION_SECRET=change-me-to-a-long-random-string-in-production
ENCRYPTION_KEY=change-me-32-bytes-base64-encoded==
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@12345
# Header name AutoStore expects for the API key (confirm with AutoStore docs)
AUTOSTORE_API_KEY_HEADER=X-Api-Key
